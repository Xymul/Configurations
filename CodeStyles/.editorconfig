[*]
end_of_line = lf
tab_width = 4
indent_size = tab
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{c,cpp,cxx,cc,h,hpp}]
indent_size = 2

[*.go]
indent_style = tab

[*.{js,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{json, yml, yaml}]
indent_size = 2
